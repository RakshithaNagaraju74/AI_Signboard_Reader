# Optional AI narration configuration for SightToSound
# Copy this file to .env and replace the placeholder with your own Groq API key.
# Keep .env private; never commit real API keys or embed them in a public release.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional OCR.Space Engine 3 key for Kannada, Tamil, Telugu, Hindi and stylized fonts.
# Get a free key at https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_ocr_space_api_key
